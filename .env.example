# ==========================================
# LakehouseFit AI — Environment Configuration
# ==========================================

# 1. Database (MongoDB Atlas)
# REQUIRED FOR DATA PERSISTENCE:
# If MONGODB_URI is omitted, LakehouseFit AI falls back to in-memory demo storage.
# In in-memory mode, assessments, reports, and registered accounts reset on server restart.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# 2. Authentication & Session Security (jose + bcryptjs)
# REQUIRED FOR PRODUCTION SECURITY:
# Secret key used by jose to sign and verify HS256 JWT auth tokens stored in HTTP-only cookies.
# Must be at least 32 characters in production. One-click demo login is disabled in production.
JWT_SECRET=lakehousefit-ai-production-jwt-secret-key-32chars

# 3. Optional AI Provider Enhancement (Google Gemini or OpenAI)
# Optional: The platform operates with full deterministic capability matching and PDF generation
# without any external AI API. Setting these enables AI-assisted report phrasing.
# Options: 'gemini' | 'openai' | empty (default: deterministic engine)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# 4. Public Application Origin
# Base URL for metadata and absolute links (defaults to http://localhost:3000 in local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
